{
  "name": "Profession",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "title": "Cl\u00e9 unique (ex: Forgeron)"
    },
    "name": {
      "type": "string",
      "title": "Nom affich\u00e9"
    },
    "icon": {
      "type": "string",
      "title": "Emoji ic\u00f4ne"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "start_gold": {
      "type": "number",
      "title": "Or de d\u00e9part",
      "default": 100
    },
    "start_items": {
      "type": "array",
      "title": "Objets de d\u00e9part",
      "items": {
        "type": "object",
        "properties": {
          "item_name": {
            "type": "string"
          },
          "item_category": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "recipes": {
      "type": "array",
      "title": "Recettes de production",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "cooldown": {
            "type": "number"
          },
          "icon": {
            "type": "string"
          },
          "costGold": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "is_active": {
      "type": "boolean",
      "title": "Actif",
      "default": true
    }
  },
  "required": [
    "key",
    "name",
    "icon"
  ]
}