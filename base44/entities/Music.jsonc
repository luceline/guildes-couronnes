{
  "name": "Music",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Titre de la musique"
    },
    "artist": {
      "type": "string",
      "title": "Artiste"
    },
    "file_url": {
      "type": "string",
      "title": "URL du fichier audio"
    },
    "pages": {
      "type": "array",
      "title": "Pages o\u00f9 jouer cette musique",
      "items": {
        "type": "string"
      },
      "description": "Ex: ['/', '/city', '/market', '/world', '/taverne']",
      "default": []
    },
    "is_active": {
      "type": "boolean",
      "title": "Actif",
      "default": true
    }
  },
  "required": [
    "title",
    "file_url"
  ]
}