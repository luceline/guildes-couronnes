{
  "name": "TavernMessage",
  "type": "object",
  "properties": {
    "city_id": {
      "type": "string",
      "title": "Ville"
    },
    "author_email": {
      "type": "string",
      "title": "Email auteur"
    },
    "author_name": {
      "type": "string",
      "title": "Nom du personnage"
    },
    "profession": {
      "type": "string",
      "title": "Métier"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "is_private": {
      "type": "boolean",
      "title": "Message privé (résidents uniquement)",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "title": "Message actif",
      "default": true
    }
  },
  "required": [
    "city_id",
    "author_email",
    "author_name",
    "message"
  ]
}