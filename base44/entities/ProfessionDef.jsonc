{
  "name": "ProfessionDef",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "title": "Cl\u00e9 unique (ex: B\u00fbcheron)"
    },
    "name": {
      "type": "string",
      "title": "Nom affich\u00e9"
    },
    "icon": {
      "type": "string",
      "title": "Emoji"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "start_gold": {
      "type": "number",
      "title": "Or de d\u00e9part",
      "default": 100
    },
    "start_items": {
      "type": "array",
      "title": "Items de d\u00e9part",
      "items": {
        "type": "object",
        "properties": {
          "item_name": {
            "type": "string"
          },
          "item_category": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "production_actions": {
      "type": "array",
      "title": "Actions de production T1",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "output_key": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "cooldown": {
            "type": "number",
            "description": "Cooldown en minutes"
          },
          "cost_gold": {
            "type": "number",
            "default": 0
          },
          "icon": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "is_active": {
      "type": "boolean",
      "title": "Actif (selectionnable)",
      "default": true
    }
  },
  "required": [
    "key",
    "name",
    "icon"
  ]
}