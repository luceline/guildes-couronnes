{
  "name": "CityObjective",
  "type": "object",
  "properties": {
    "city_id": {
      "type": "string",
      "title": "Ville"
    },
    "title": {
      "type": "string",
      "title": "Titre de l'objectif"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "required_resources": {
      "type": "object",
      "title": "Ressources requises",
      "properties": {
        "bois": {
          "type": "number",
          "default": 0
        },
        "pierre": {
          "type": "number",
          "default": 0
        },
        "fer": {
          "type": "number",
          "default": 0
        },
        "nourriture": {
          "type": "number",
          "default": 0
        },
        "tissu": {
          "type": "number",
          "default": 0
        },
        "or": {
          "type": "number",
          "default": 0
        }
      }
    },
    "reward_type": {
      "type": "string",
      "title": "Type de récompense",
      "enum": [
        "building",
        "population_increase",
        "treasury"
      ]
    },
    "reward_value": {
      "type": "string",
      "title": "Valeur de la récompense"
    },
    "status": {
      "type": "string",
      "title": "Statut",
      "enum": [
        "active",
        "completed"
      ],
      "default": "active"
    },
    "contributed_resources": {
      "type": "object",
      "title": "Ressources contribuées",
      "properties": {
        "bois": {
          "type": "number",
          "default": 0
        },
        "pierre": {
          "type": "number",
          "default": 0
        },
        "fer": {
          "type": "number",
          "default": 0
        },
        "nourriture": {
          "type": "number",
          "default": 0
        },
        "tissu": {
          "type": "number",
          "default": 0
        },
        "or": {
          "type": "number",
          "default": 0
        }
      },
      "default": {}
    },
    "reward_gold": {
      "type": "number",
      "title": "Récompense or",
      "default": 0
    }
  },
  "required": [
    "city_id",
    "title",
    "required_resources",
    "reward_type"
  ]
}
